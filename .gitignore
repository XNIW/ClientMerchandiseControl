#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local compile-time configuration
/config/*.local.json

# Local environment files; versioned examples remain allowed
.env
.env.*
!.env.example
!.env.*.example

# Signing credentials and provisioning artifacts
*.jks
*.keystore
*.p8
*.p12
*.pfx
*.mobileprovision
/android/key.properties

# Local mobile service configuration
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist
/ios/Flutter/Maps.local.xcconfig
